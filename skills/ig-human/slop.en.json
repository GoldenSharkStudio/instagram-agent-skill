  "inflection": {
    "note": "How a lexicon entry inflects. Every inflected form is its own entry, with its own replacement, so humanize keeps the sentence grammatical ('elevates' -> 'improves', not 'improve'), and it names its base in `of`. The test suite derives the forms each base should have from these rules and fails on a form missing from the lexicon. A base that does not inflect in use goes in `exempt`, with the reason. Suffix rules are tried in order, the first whose pattern matches the inflected word wins.",
    "families": {
      "verbs": {
        "word": "first",
        "forms": [
          "s",
          "ed",
          "ing"
        ]
      },
      "nouns": {
        "word": "last",
        "forms": [
          "s"
        ]
      }
    },
    "suffixes": {
      "s": [
        {
          "pattern": "([^aeiou])y$",
          "to": "\\1ies"
        },
        {
          "pattern": "(s|sh|ch|x|z)$",
          "to": "\\1es"
        },
        {
          "pattern": "$",
          "to": "s"
        }
      ],
      "ed": [
        {
          "pattern": "([^aeiou])y$",
          "to": "\\1ied"
        },
        {
          "pattern": "e$",
          "to": "ed"
        },
        {
          "pattern": "$",
          "to": "ed"
        }
      ],
      "ing": [
        {
          "pattern": "([^e])e$",
          "to": "\\1ing"
        },
        {
          "pattern": "$",
          "to": "ing"
        }
      ]
    },
    "exempt": [
      {
        "base": "testament to",
        "why": "only singular in use ('a testament to')"
      },
      {
        "base": "a testament to",
        "why": "the article fixes it singular"
      },
      {
        "base": "plethora of",
        "why": "only singular in use ('a plethora of')"
      },
      {
        "base": "plethora",
        "why": "only singular in use"
      },
      {
        "base": "a plethora of",
        "why": "the article fixes it singular"
      },
      {
        "base": "a plethora",
        "why": "the article fixes it singular"
      },
      {
        "base": "secret sauce",
        "why": "mass noun"
      },
      {
        "base": "the algorithm loves",
        "why": "a clause, not a noun"
      },
      {
        "base": "beat the algorithm",
        "why": "a closing phrase, said as an imperative"
      },
      {
