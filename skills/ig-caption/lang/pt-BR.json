    "messages": {
      "feed_title": "\n  O QUE O FEED MOSTRA",
      "feed_more": "  +-------------------------------------------- ... mais +",
      "feed_whole": "  +------------------------------ (a legenda cabe toda) +",
      "length_ok": "{chars} / {limit} caracteres",
      "length_over": "{chars} / {limit} caracteres, {over} acima do limite",
      "first_line_blank": "a legenda abre numa linha em branco",
      "first_line_tag": "abre numa hashtag ou numa menção, justo na única posição que vale uma frase",
      "first_line_cut": "{chars} caracteres, então é cortada em {cut} no meio do raciocínio. Tudo bem se o corte é um gancho, ruim se é uma oração subordinada",
      "first_line_whole": "{chars} caracteres, aparece inteira",
      "hook_concrete": "{count} número(s) ou nome(s) na parte visível",
      "hook_abstract": "{count} número(s) ou nome(s) na parte visível - nada que dê para conferir antes do toque",
      "hashtags_over": "{count} tags, acima do limite de {limit} do Instagram. Tags depois da quinta não contam e o bloco parece antigo",
      "hashtags_cap_generic": "{count} tags, no limite, e {generic} delas genéricas. Gaste as cinco em temas",
      "hashtags_generic": "{count} tags, {generic} delas genéricas ({examples}). Essas não descrevem nada",
      "hashtags_listed": "{count} tag(s): {tags}",
      "hashtags_none": "{count} tag(s)",
      "placement_none": "nenhuma tag para posicionar",
      "placement_window": "tem hashtag na parte visível, gastando espaço do feed com um rótulo",
      "placement_below": "as tags estão abaixo da dobra",
      "links_found": "{count} link(s) na legenda, e legenda não é clicável. Leve para a bio ou para o direct",
      "links_none": "nenhum link morto no corpo",
      "ask_one": "uma chamada para ação: {ask}",
      "ask_none": "nenhuma chamada para ação. Decida para que serve este post",
      "ask_many": "{count} pedidos ({asks}). Dois pedidos é o mesmo que nenhum",
      "emoji_plain": "{count} emoji, {density:.1f} a cada 100 caracteres",
      "emoji_decoration": "{count} emoji, {density:.1f} a cada 100 caracteres - parece enfeite",
      "terms_present": "{found}/{total} presentes",
      "terms_in_window": ", {count} na parte visível",
      "terms_missing": ". Faltando: {missing}",
      "head": "REVISÃO DA LEGENDA  ·  {chars} / {limit} caracteres  ·  {tags} hashtags  ·  {asks} pedido(s)",
      "verdict_line": "  VEREDITO  {verdict}\n"
    }
