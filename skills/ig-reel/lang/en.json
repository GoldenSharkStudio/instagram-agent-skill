      "hook_note": "Beat 1 takes {secs:.1f}s to say. Cut it to {words} words or fewer, or the hook lands after the decision has been made.",
      "hook_abstract_note": "Beat 1 has no number and no name in it. Hooks without something checkable are the ones that get scrolled.",
      "long_beat_flag": "{secs:.1f}s on one beat",
      "long_beats_note": "Beat(s) {beats} run past {limit:.0f}s. Either split the line or change what is on screen inside it. A static frame is where people leave.",
      "abstract_run_note": "Beats {first}-{last} have nothing concrete in them. Put a number, a name or a price in one of them.",
      "loop_note": "Loops: the last beat repeats \"{words}\" from the hook. Second watches are free reach.",
      "no_loop_note": "No loop. The last beat shares no word with the hook, so the video ends flat. Echoing one word from beat 1 is the cheapest replay you get.",
      "on_target_note": "Length is on target ({secs:.1f}s against {target}s).",
      "over_target_note": "{secs:.1f}s over target. Cut about {words} words.",
