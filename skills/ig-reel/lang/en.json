    "dealbreakers": [
      {
        "regex": "(?i)^\\s*(?:stop scrolling|don'?t scroll)",
        "message": "Opens with \"stop scrolling\". Asking for attention proves you have not earned it."
      },
      {
        "regex": "(?i)\\b(?:in (?:this|today'?s) (?:video|reel)|i'?m going to show you|i'?ll show you how)\\b",
        "message": "Video preamble. Delete it and open on the payoff."
